# Copy this file to env/app.env and fill in the {{PLACEHOLDER}} values.
# Every service (api, datadog, frontend) reads from this same file —
# each just ignores the variables it doesn't need.

# ---- Gemini (LLM — required) ----
# Get a key at https://aistudio.google.com -> Get API key
GEMINI_API_KEY={{GEMINI_API_KEY}}
LLM_MODEL={{LLM_MODEL}}
JUDGE_MODEL={{JUDGE_MODEL}}
GROUNDING_MODEL={{JUDGE_MODEL}}
SYSTEM_PROMPT_PATH={{PROMPT_PATH}}
TRUST_WEIGHTS=0.4,0.4,0.2

# Voice narration — same GEMINI_API_KEY above, no separate credential.
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore

# ---- YouCam Skin AI (required for real scans; leave mock mode on until you have a key) ----
# Get a key at https://yce.perfectcorp.com
YOUCAM_API_KEY={{YOUCAM_API_KEY}}
YOUCAM_API_BASE=https://yce-api-01.makeupar.com
YOUCAM_CONCERNS=moisture,wrinkle,redness,age_spot,acne,pore
YOUCAM_TIER=sd
YOUCAM_MOCK_MODE=true
YOUCAM_MAX_UNITS_PER_SESSION=50

# ---- Scan history storage ----
SCAN_DB_PATH=/app/data/scan_history.db

# ---- Google Sign-In (optional — app works fully anonymous without it) ----
# Get a Client ID at console.cloud.google.com -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Web application.
# The same client ID also needs to go in frontend/.env.local as
# VITE_GOOGLE_CLIENT_ID (Vite reads that at build time, not from this file).
GOOGLE_CLIENT_ID={{GOOGLE_CLIENT_ID}}

# ---- CORS ----
CORS_ALLOW_ORIGINS=*

# ---- Datadog agent + APM/LLM Observability (optional) ----
# Get an API key at Datadog -> Organization Settings -> API Keys
DD_AGENT_HOST=datadog
DD_PORT=8125
DD_BIND_HOST={{ADDRESS_TO_BIND}}
DD_API_KEY={{YOUR_DD_API_KEY}}
DD_SITE={{YOUR_DD_SITE}}
DD_LLMOBS_ENABLED=1
DD_APM_ENABLED=true
DD_LOGS_ENABLED=false
DD_LLMOBS_ML_APP={{LLM_APP}}
DD_DOGSTATSD_NON_LOCAL_TRAFFIC=true

# ---- Datadog RUM (optional, frontend browser monitoring) ----
# Get these at Datadog -> Digital Experience -> RUM Applications -> New Application (React)
VITE_DD_APPLICATION_ID={{YOUR_APPLICATION_ID}}
VITE_DD_CLIENT_TOKEN={{YOUR_CLIENT_ID}}
VITE_DD_SITE=us5.datadoghq.com
VITE_DD_ENV={{YOUR_DD_ENV}}
VITE_DD_SERVICE={{YOUR_DD_SERVICE}}
